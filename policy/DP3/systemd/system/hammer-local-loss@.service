[Unit]
Description=Persistent Hammer semantic loss ablation (%i)
After=local-fs.target
StartLimitIntervalSec=600
StartLimitBurst=20
ConditionPathExists=/home/zheng/github/RoboTwin_geo/policy/DP3/scripts/run_hammer_local_loss_service.sh

[Service]
Type=simple
User=zheng
Group=zheng
WorkingDirectory=/home/zheng/github/RoboTwin_geo
Environment=HOME=/home/zheng
Environment=CUDA_VISIBLE_DEVICES=0
Environment=PYTHON_BIN=/home/zheng/miniforge3/envs/RoboTwin/bin/python
Environment=OUTPUT_ROOT=/home/zheng/github/RoboTwin_geo/outputs/paper_revision/hammer_semantic_loss_ablation_local4090_seed20260807_e4000_fastw4_resumable_restart20260806
Environment=FAST_PATH=1
Environment=AUTO_RESUME=1
Environment=NUM_WORKERS=0
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/bash /home/zheng/github/RoboTwin_geo/policy/DP3/scripts/run_hammer_local_loss_service.sh %i
Restart=on-failure
RestartSec=15s
TimeoutStopSec=120s
MemoryAccounting=yes
MemoryHigh=7G
MemoryMax=9G
MemorySwapMax=512M
ManagedOOMPreference=avoid
OOMPolicy=stop
OOMScoreAdjust=-500
TasksMax=512
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
