[Unit]
Description=Persistent Hammer remote completion sync watcher
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=20
ConditionPathExists=/home/zheng/github/RoboTwin_geo/policy/DP3/scripts/watch_remote_hammer_loss_ablation.sh

[Service]
Type=simple
User=zheng
Group=zheng
WorkingDirectory=/home/zheng/github/RoboTwin_geo
Environment=HOME=/home/zheng
Environment=REMOTE_HOST=root@112.69.3.12
Environment=REMOTE_PORT=43678
Environment=POLL_SECONDS=30
Environment=LOCAL_BASE=/home/zheng/github/RoboTwin_geo/outputs/paper_revision/remote_rtx6000/formal
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
ExecStart=/bin/bash /home/zheng/github/RoboTwin_geo/policy/DP3/scripts/watch_remote_hammer_loss_ablation.sh
Restart=on-failure
RestartSec=30s
TimeoutStopSec=60s
MemoryAccounting=yes
MemoryHigh=512M
MemoryMax=1G
MemorySwapMax=128M
ManagedOOMPreference=avoid
OOMPolicy=stop
OOMScoreAdjust=-500
TasksMax=128
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
